{
  "name": "camera-plus-card",
  "version": "0.1.0-beta.3",
  "description": "Home Assistant camera card with live WebRTC, digital zoom, press-and-hold PTZ and a door button.",
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "custom-card",
    "camera",
    "webrtc",
    "ptz",
    "reolink"
  ],
  "homepage": "https://github.com/wendevlin/camera-plus-card#readme",
  "bugs": {
    "url": "https://github.com/wendevlin/camera-plus-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendevlin/camera-plus-card.git"
  },
  "author": "Wendelin",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bunx --bun vite build --watch --mode development",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host --port 5173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "ci": "bun run lint && bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "shadcn-svelte": "1.7.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@lucide/svelte": "^1.62.0",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  }
}
